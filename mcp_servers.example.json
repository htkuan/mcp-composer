{
  "mcpServers": {
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "everything": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "remote-http": {
      "url": "http://127.0.0.1:8001/mcp"
    },
    "remote-sse": {
      "type": "sse",
      "url": "http://127.0.0.1:8002/sse"
    },
    "postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/postgres",
        "postgresql://postgres:postgres@localhost:5432/postgres"
      ]
    }
  }
}