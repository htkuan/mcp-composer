HOST=0.0.0.0
PORT=8000

MCP_COMPOSER_PROXY_URL=http://localhost:8000
MCP_SERVERS_CONFIG_PATH=./mcp_servers.json

# Allowed Origin headers for the MCP endpoints (comma-separated, `:*` = any port, `*` disables the check)
# Defaults to the origin of MCP_COMPOSER_PROXY_URL plus localhost on any port
# MCP_ALLOWED_ORIGINS=http://localhost:*,https://mcp.example.com
